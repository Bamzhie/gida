# Copy to backend/.env (gitignored) — Spring loads it automatically via
# spring.config.import when the backend runs from backend/. Real environment
# variables still take precedence over this file.
DB_URL=jdbc:postgresql://localhost:5432/gida_dev
DB_USER=gida
DB_PASSWORD=change-me
JWT_SECRET=replace-with-openssl-rand-base64-48
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Credentials of the seeded dev advertiser, used by `npm run smoke` for the
# advertiser-inbox section. Must match the hash in R__dev_seed.sql.
SMOKE_AGENT_EMAIL=adebayo@gida.local
SMOKE_AGENT_PASSWORD=replace-with-the-seed-password
